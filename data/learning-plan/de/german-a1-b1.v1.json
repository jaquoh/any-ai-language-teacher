            "er_sie_es": "hat",
            "wir": "haben",
            "ihr": "habt",
            "sie_Sie": "haben"
          }
        }
      ],
      "vocabThemes": [
        "love and valentines day",
        "relationship",
        "friends and dating",
        "supermarket",
        "activities"
      ],
      "exercisePatterns": [
        "Fill in missing verb forms with romantic mini-dialogues.",
        "Choose correct article and adjective in compliment sentences.",
        "Answer invitation and date-planning prompts with new vocabulary."
      ],
      "funBreakIdeas": [
        "Word of the day tied to love and relationships.",
        "Short Valentine's themed tongue twister."
      ],
      "completionChecks": [
