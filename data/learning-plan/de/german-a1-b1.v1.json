      "title": "Foundations of Connection: Love, Valentine's Day, and warm introductions",
      "durationMin": {
        "min": 15,
        "max": 20
      },
      "prerequisites": [],
      "lessonObjectives": [
        "Introduce yourself warmly in a romantic or friendly Valentine's context.",
        "Use present tense forms of sein and haben to express feelings and preferences.",
        "Build simple sentences about affection, compliments, invitations, and plans."
      ],
      "grammarTargets": [
        {
          "id": "word-order-main",
          "name": "Main clause word order",
          "example": "Ich wohne in Berlin."
        },
        {
          "id": "articles-basic",
          "name": "Definite and indefinite articles",
          "example": "Das ist ein Freund."
        }
      ],
      "verbTargets": [
        {
          "infinitive": "sein",
