{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://any-ai-teacher.local/schemas/learning-plan.schema.json",
  "title": "LearningPlanData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "planVersion",
    "targetLanguage",
    "uiLanguage",
    "cefrRange",
    "teachingPrinciples",
    "modules"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "planId": { "type": "string", "minLength": 3 },
    "planVersion": { "type": "string", "minLength": 1 },
    "targetLanguage": { "type": "string", "minLength": 2 },
    "uiLanguage": { "type": "string", "minLength": 2 },
    "cefrRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 2 },
        "to": { "type": "string", "minLength": 2 }
      }
    },
    "teachingPrinciples": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 3 }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moduleId",
          "order",
          "cefr",
          "title",
          "durationMin",
          "prerequisites",
          "lessonObjectives",
          "grammarTargets",
          "verbTargets",
          "vocabThemes",
          "exercisePatterns",
          "funBreakIdeas",
          "completionChecks"
        ],
        "properties": {
          "moduleId": { "type": "string", "minLength": 3 },
          "order": { "type": "integer", "minimum": 1 },
          "cefr": { "type": "string", "minLength": 3 },
          "title": { "type": "string", "minLength": 3 },
          "durationMin": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "integer", "minimum": 12, "maximum": 20 },
              "max": { "type": "integer", "minimum": 15, "maximum": 25 }
            }
          },
          "prerequisites": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "lessonObjectives": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 3 }
          },
          "grammarTargets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "example"],
              "properties": {
                "id": { "type": "string", "minLength": 2 },
                "name": { "type": "string", "minLength": 2 },
                "example": { "type": "string", "minLength": 3 }
              }
            }
          },
          "verbTargets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["infinitive", "present"],
              "properties": {
                "infinitive": { "type": "string", "minLength": 2 },
                "present": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ich", "du", "er_sie_es", "wir", "ihr", "sie_Sie"],
                  "properties": {
                    "ich": { "type": "string", "minLength": 2 },
                    "du": { "type": "string", "minLength": 2 },
                    "er_sie_es": { "type": "string", "minLength": 2 },
                    "wir": { "type": "string", "minLength": 2 },
                    "ihr": { "type": "string", "minLength": 2 },
                    "sie_Sie": { "type": "string", "minLength": 2 }
                  }
                }
              }
            }
          },
          "vocabThemes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          },
          "exercisePatterns": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 3 }
          },
          "funBreakIdeas": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "completionChecks": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 3 }
          }
        }
      }
    }
  }
}
